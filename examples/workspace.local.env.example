# Local Home Root -> Data Repo configuration
# Copy to ./workspace.local.env (gitignored) or run ./scripts/init_workspace.sh

# Path to your private Data Repo (relative to knowledge-loop root, or ~/... path)
DATA_REPO_DIR="../my-knowledge-data"

# Preferred IANA timezone (e.g., UTC, America/Los_Angeles, Asia/Taipei)
USER_TIMEZONE="UTC"
