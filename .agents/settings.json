{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "name": "prevent-dangerous-commands",
            "type": "command",
            "command": "./scripts/hooks/prevent_dangerous_commands.sh"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "name": "sync-subagents-and-validate",
            "type": "command",
            "command": "python3 scripts/validate_skill.py && python3 scripts/validate_public.py && python3 scripts/sync_subagents.py"
          }
        ]
      }
    ]
  }
}
